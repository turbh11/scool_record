# החלף בערכי הפרויקט שלך מתוך לוח הבקרה של Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# מפתח Service Role (אופציונלי - מומלץ עבור /super-admin להקמת משתמשי מנהלים באופן אוטומטי ללא אימות מייל)
SUPABASE_SERVICE_ROLE_KEY=

# רשימת כתובות דוא"ל של מנהלי-על (Super Admin), מופרדות בפסיקים. רק הם יוכלו לגשת ל-/super-admin
SUPER_ADMIN_EMAILS=owner@example.com,partner@example.com

# פרטי חשבון Gmail לשליחת מיילים אוטומטית בחינם לכל כתובת (באמצעות App Password של Google)
GMAIL_USER=
GMAIL_APP_PASSWORD=
